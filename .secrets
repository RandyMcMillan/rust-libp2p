# Dummy secrets for local act runs
# The build-interop-image.sh script handles missing AWS_SECRET_ACCESS_KEY gracefully
# by skipping S3 cache writes. Cache-from will fail silently and build from scratch.
S3_LIBP2P_BUILD_CACHE_AWS_SECRET_ACCESS_KEY=dummy-secret-for-local-act
S3_LIBP2P_BUILD_CACHE_BUCKET_NAME=dummy-bucket
S3_LIBP2P_BUILD_CACHE_AWS_ACCESS_KEY_ID=dummy-key
S3_LIBP2P_BUILD_CACHE_AWS_REGION=us-east-1
